# App
APP_NAME=Sales Analytics Chatbot
APP_ENV=development
LOG_LEVEL=INFO

# AWS / Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Database (Option A: full URL)
# DATABASE_URL=postgresql+psycopg2://username:password@host:5432/salesdb

# Database (Option B: individual fields)
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=salesdb
DB_USER=postgres
DB_PASSWORD=replace-with-strong-password
DB_SSL_MODE=require

# Safety
ALLOWED_TABLES=sales,products,customers
MAX_RESULT_ROWS=100
MEMORY_SIZE=5
