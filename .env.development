# Development Environment (SQLite + Mock Bedrock for testing)
# Copy to .env and update AWS_REGION and BEDROCK_MODEL_ID before running

# Application
APP_NAME=Sales Analytics Chatbot
APP_ENV=development
LOG_LEVEL=INFO

# AWS (required - update with your credentials)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Database - SQLite (no setup needed for local development)
# Uses simple file-based RDB, auto-creates on first run
DATABASE_URL=sqlite:///./sales_analytics.db

# Database - PostgreSQL (comment out DATABASE_URL above to use)
# If running docker-compose, use these defaults:
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=salesdb
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_SSL_MODE=disable

# If using AWS RDS, update these:
# DB_HOST=your-instance.xxxxx.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=salesdb
# DB_USER=postgres
# DB_PASSWORD=your-strong-password
# DB_SSL_MODE=require

# Safety
ALLOWED_TABLES=sales,products,customers
MAX_RESULT_ROWS=100
MEMORY_SIZE=5
